# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Bun-only project: bun.lock is the single source of truth. Never commit a
# foreign package-manager lockfile — they silently drift from bun.lock (which
# is exactly how vite/tailwind versions diverged before). See PR #34.
package-lock.json
yarn.lock
pnpm-lock.yaml

# Stray TS/Vue compile output — the build sets noEmit, so vue-tsc should never
# write .js next to sources; this is a backstop if emit is ever re-enabled.
src/**/*.js

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.gstack/
